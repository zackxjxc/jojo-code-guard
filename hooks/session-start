#!/usr/bin/env bash
# 会话入口：注入自动守护规则和当前项目 AGENTS.md。
set -euo pipefail

absolute_directory() {
    local directory="$1"
    if command -v cygpath >/dev/null 2>&1; then
        cygpath -am "$directory"
    else
        (cd "$directory" 2>/dev/null && pwd)
    fi
}

plugin_root="${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}"
if [ -n "$plugin_root" ]; then
    PLUGIN_ROOT="$plugin_root"
else
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi
# 客户端在 Windows 可能传入反斜杠路径，先转换为 Bash 可识别的形式
PLUGIN_ROOT="${PLUGIN_ROOT//\\\\//}"
if resolved_plugin_root="$(absolute_directory "$PLUGIN_ROOT" 2>/dev/null)"; then
    PLUGIN_ROOT="$resolved_plugin_root"
fi
SKILL_FILE="${PLUGIN_ROOT}/skills/jojo-code-guard/SKILL.md"

select_python() {
    if command -v py >/dev/null 2>&1 && py -3 -c 'import sys' >/dev/null 2>&1; then
        PYTHON=(py -3)
    elif command -v python3 >/dev/null 2>&1; then
        PYTHON=(python3)
    elif command -v python >/dev/null 2>&1 \
        && python -c 'import sys; raise SystemExit(sys.version_info[0] != 3)' >/dev/null 2>&1; then
        PYTHON=(python)
    else
        return 1
    fi
}

emit_context_payload() {
    local context="$1"
    local payload
    if select_python && payload="$(printf '%s' "$context" | PYTHONIOENCODING=utf-8 "${PYTHON[@]}" -c '
import json
import sys

payload = {
    "hookSpecificOutput": {
        "hookEventName": "SessionStart",
        "additionalContext": sys.stdin.read(),
    }
}
print(json.dumps(payload, ensure_ascii=False))
' 2>/dev/null)"; then
        printf '%s\n' "$payload"
        return 0
    fi
    # 两端都支持普通 stdout；仅在结构化输出不可用时使用兼容回退。
    printf '%s\n' "$context"
}

if [ ! -r "$SKILL_FILE" ]; then
    load_error="jojo-code-guard: 无法读取 Skill：${SKILL_FILE}"
    load_context="<JOJO_CODE_GUARD_LOAD_FAILED>${load_error}；"
    load_context="${load_context}必须暂停文件修改并向用户报告。</JOJO_CODE_GUARD_LOAD_FAILED>"
    printf '%s\n' "$load_error" >&2
    emit_context_payload "$load_context"
    exit 0
fi

if [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
    project_root="$CLAUDE_PROJECT_DIR"
else
    project_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
fi
project_root="${project_root//\\\\//}"
if git_root="$(git -C "$project_root" rev-parse --show-toplevel 2>/dev/null)"; then
    project_root="$git_root"
fi
if resolved_project_root="$(absolute_directory "$project_root" 2>/dev/null)"; then
    project_root="$resolved_project_root"
fi
common_rules="${PLUGIN_ROOT}/skills/jojo-code-guard/通用规则.md"
project_rules="${project_root}/AGENTS.md"

# 只注入短加载指令和绝对路径，避免客户端把完整规则溢出到临时文件或截断。
emit_load_instruction() {
    printf '%s\n' '<JOJO_CODE_GUARD_LOAD_INSTRUCTION>'
    printf '%s\n' '在生成回复或修改文件前，必须使用可用的文件读取能力依次完整读取并遵守下列文件。'
    printf '%s\n' '路径提示不等于已加载文件内容，不得仅凭本段摘要继续。'
    printf '1. 必需 Skill：%s\n' "$SKILL_FILE"
    if [ -f "$common_rules" ]; then
        printf '2. 通用规则：%s\n' "$common_rules"
    fi
    if [ -f "$project_rules" ]; then
        printf '3. 当前项目规则：%s\n' "$project_rules"
    fi
    printf '%s\n' '规则优先级：系统/用户明确要求 > 项目规则 > Skill 及其引用规则。'
    printf '%s\n' '若任一列出的文件无法完整读取，立即暂停文件修改并向用户报告。'
    printf '%s\n' '已有修改不等于本轮污染；不得自动恢复、覆盖或删除来源不明的内容。'
    printf '%s\n' '</JOJO_CODE_GUARD_LOAD_INSTRUCTION>'
}

# 结构化 additionalContext 明确标记事件边界，并保留普通 stdout 兼容回退。
context="$(emit_load_instruction)"
emit_context_payload "$context"
