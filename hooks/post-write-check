#!/usr/bin/env bash
# 回合开始时记录差异基线，文件工具完成或 AI 回合结束时返回对应的 Hook 协议。
set -u

# 先读取一次事件输入，后续同时解析 cwd 和 Stop 重入标记。
HOOK_INPUT="$(cat || true)"

if command -v py >/dev/null 2>&1 && py -3 -c 'import sys' >/dev/null 2>&1; then
    PYTHON=(py -3)
elif command -v python3 >/dev/null 2>&1; then
    PYTHON=(python3)
elif command -v python >/dev/null 2>&1 \
    && python -c 'import sys; raise SystemExit(sys.version_info[0] != 3)' >/dev/null 2>&1; then
    PYTHON=(python)
else
    echo "jojo-code-guard: Python 3 is required for lifecycle checks." >&2
    exit 2
fi

HOOK_EVENT="${1:-}"
if [ -z "$HOOK_EVENT" ]; then
    HOOK_EVENT="$(printf '%s' "$HOOK_INPUT" | PYTHONIOENCODING=utf-8 "${PYTHON[@]}" -c '
import json
import sys

try:
    value = json.load(sys.stdin).get("hook_event_name", "")
except (AttributeError, json.JSONDecodeError, UnicodeDecodeError):
    value = ""
print(value if isinstance(value, str) else "")
' 2>/dev/null || true)"
fi
HOOK_EVENT="${HOOK_EVENT:-PostToolUse}"
if [ "$HOOK_EVENT" != "UserPromptSubmit" ] \
    && [ "$HOOK_EVENT" != "PostToolUse" ] \
    && [ "$HOOK_EVENT" != "Stop" ]; then
    echo "jojo-code-guard: unsupported hook event: ${HOOK_EVENT}" >&2
    exit 2
fi

plugin_root="${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}"
if [ -n "$plugin_root" ]; then
    PLUGIN_ROOT="$plugin_root"
else
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi
# 客户端在 Windows 可能传入反斜杠路径，先转换为 Bash 可识别的形式
PLUGIN_ROOT="${PLUGIN_ROOT//\\\\//}"
CHECK_SCRIPT="${PLUGIN_ROOT}/skills/jojo-code-guard/scripts/check_diff.py"
BASELINE_SCRIPT="${PLUGIN_ROOT}/skills/jojo-code-guard/scripts/hook_baseline.py"

if [ "$HOOK_EVENT" = "Stop" ]; then
    STOP_HOOK_ACTIVE="$(printf '%s' "$HOOK_INPUT" | PYTHONIOENCODING=utf-8 "${PYTHON[@]}" -c '
import json
import sys

try:
    value = json.load(sys.stdin).get("stop_hook_active", False)
except (AttributeError, json.JSONDecodeError, UnicodeDecodeError):
    value = False
print("true" if value is True else "false")
' 2>/dev/null || printf 'false')"
    if [ "$STOP_HOOK_ACTIVE" = "true" ]; then
        exit 0
    fi
fi

if [ ! -r "$CHECK_SCRIPT" ]; then
    echo "jojo-code-guard: 无法读取差异检查脚本：${CHECK_SCRIPT}" >&2
    exit 2
fi

# 客户端事件中的 cwd 最接近本次工具调用；解析失败时再使用环境变量或进程目录。
INPUT_CWD="$(printf '%s' "$HOOK_INPUT" | PYTHONIOENCODING=utf-8 "${PYTHON[@]}" -c '
import json
import sys

try:
    value = json.load(sys.stdin).get("cwd", "")
except (AttributeError, json.JSONDecodeError, UnicodeDecodeError):
    value = ""
print(value if isinstance(value, str) else "")
' 2>/dev/null || true)"
if [ -n "$INPUT_CWD" ]; then
    PROJECT_ROOT="$INPUT_CWD"
elif [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
    PROJECT_ROOT="$CLAUDE_PROJECT_DIR"
else
    PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
fi
PROJECT_ROOT="${PROJECT_ROOT//\\\\//}"

emit_empty_result() {
    return 0
}

# 非 Git 目录不属于本守护范围，避免普通文件操作被无意义地阻断。
if [ -z "$PROJECT_ROOT" ]; then
    emit_empty_result
    exit 0
fi
if ! PROJECT_ROOT="$(git -C "$PROJECT_ROOT" rev-parse --show-toplevel 2>/dev/null)"; then
    emit_empty_result
    exit 0
fi

read_hook_field() {
    printf '%s' "$HOOK_INPUT" | PYTHONIOENCODING=utf-8 "${PYTHON[@]}" -c '
import json
import sys

try:
    value = json.load(sys.stdin).get(sys.argv[1], "")
except (AttributeError, json.JSONDecodeError, UnicodeDecodeError):
    value = ""
print(value if isinstance(value, str) else "")
' "$1" 2>/dev/null || true
}

SESSION_ID="$(read_hook_field session_id)"
TURN_ID="$(read_hook_field turn_id)"

set +e
OUTPUT="$("${PYTHON[@]}" "$CHECK_SCRIPT" --repo "$PROJECT_ROOT" --json 2>&1)"
STATUS=$?
set -e

# 用户提示提交发生在本轮工具调用之前；只记录基线，不阻断或改写用户请求。
if [ "$HOOK_EVENT" = "UserPromptSubmit" ]; then
    if [ -r "$BASELINE_SCRIPT" ]; then
        # 先覆盖同键旧缓存；即使本次检查或实际记录失败，后续也只能按严格模式处理。
        printf '[]' | PYTHONIOENCODING=utf-8 "${PYTHON[@]}" "$BASELINE_SCRIPT" record \
            --repo "$PROJECT_ROOT" --session-id "$SESSION_ID" --turn-id "$TURN_ID" \
            >/dev/null 2>&1 || true
        if [ "$STATUS" -le 1 ]; then
            printf '%s' "$OUTPUT" | PYTHONIOENCODING=utf-8 "${PYTHON[@]}" "$BASELINE_SCRIPT" record \
                --repo "$PROJECT_ROOT" --session-id "$SESSION_ID" --turn-id "$TURN_ID" \
                >/dev/null 2>&1 || true
        fi
    fi
    exit 0
fi

# 基线缺失或过滤失败时保持原始严格诊断，避免把本轮污染误降级。
if [ "$STATUS" -le 1 ] && [ -r "$BASELINE_SCRIPT" ]; then
    if FILTERED_OUTPUT="$(
        printf '%s' "$OUTPUT" | PYTHONIOENCODING=utf-8 "${PYTHON[@]}" "$BASELINE_SCRIPT" filter \
            --repo "$PROJECT_ROOT" --session-id "$SESSION_ID" --turn-id "$TURN_ID" 2>/dev/null
    )"; then
        OUTPUT="$FILTERED_OUTPUT"
        if FILTERED_BLOCKED="$(printf '%s' "$OUTPUT" | PYTHONIOENCODING=utf-8 "${PYTHON[@]}" -c '
import json
import sys

try:
    diagnostics = json.load(sys.stdin)
except (json.JSONDecodeError, UnicodeDecodeError):
    raise SystemExit(1)
if not isinstance(diagnostics, list):
    raise SystemExit(1)
print("true" if any(
    isinstance(item, dict) and item.get("level") == "BLOCKED"
    for item in diagnostics
) else "false")
' 2>/dev/null)"; then
            if [ "$FILTERED_BLOCKED" = "true" ]; then
                STATUS=1
            else
                STATUS=0
            fi
        fi
    fi
fi

BLOCKED=false
if [ "$STATUS" -ge 2 ]; then
    BLOCKED=true
    CONTEXT="jojo-code-guard: 差异检查执行失败：
${OUTPUT}"
elif [ -z "$OUTPUT" ]; then
    BLOCKED=true
    CONTEXT="jojo-code-guard: check_diff.py 未返回 JSON 诊断，已按阻断处理。"
elif [ "$OUTPUT" = "[]" ] && [ "$STATUS" -eq 0 ]; then
    emit_empty_result
    exit 0
elif [ "$OUTPUT" = "[]" ] && [ "$STATUS" -eq 1 ]; then
    BLOCKED=true
    CONTEXT="jojo-code-guard: check_diff.py 返回阻断状态但没有诊断，已按阻断处理。"
else
    if [ "$HOOK_EVENT" = "Stop" ]; then
        CONTEXT="$(printf 'jojo-code-guard: 回合结束前的工作区检查结果：\n%s' "$OUTPUT")"
    else
        CONTEXT="$(printf 'jojo-code-guard: 工具完成后的工作区检查结果：\n%s' "$OUTPUT")"
    fi
    if BLOCKED_RESULT="$(
        printf '%s' "$OUTPUT" | PYTHONIOENCODING=utf-8 "${PYTHON[@]}" -c '
import json
import sys

data = json.load(sys.stdin)
if not isinstance(data, list) or not all(isinstance(item, dict) for item in data):
    raise ValueError("diagnostics must be a JSON array of objects")
print("true" if any(item.get("level") == "BLOCKED" for item in data) else "false")
' 2>/dev/null
    )"; then
        if [ "$STATUS" -eq 1 ] || [ "$BLOCKED_RESULT" = "true" ]; then
            BLOCKED=true
        fi
    else
        BLOCKED=true
        CONTEXT="${CONTEXT}
jojo-code-guard: 检查输出无法解析，已按阻断处理。"
    fi
fi

# 诊断可能覆盖会话开始前就存在的工作区内容，不能据此推断修改来源。
CONTEXT="${CONTEXT}
注意：结果可能包含会话开始前已有修改；已有修改不等于本轮污染。不得自动恢复、覆盖或删除来源不明或无法归因于本轮的内容。"

# Stop 只在阻断时要求继续处理；PostToolUse 会把所有诊断立即反馈给 AI。
if [ "$HOOK_EVENT" = "Stop" ] && [ "$BLOCKED" != "true" ]; then
    exit 0
fi
if [ "$HOOK_EVENT" = "Stop" ] && [ "$BLOCKED" = "true" ]; then
    LAST_ASSISTANT_MESSAGE="$(read_hook_field last_assistant_message)"
    if [ -n "$LAST_ASSISTANT_MESSAGE" ]; then
        CONTEXT="${CONTEXT}
这是 jojo-code-guard 触发的内部续跑，不是用户提出的新需求。客户端提供的待交付答案如下：
<JOJO_PENDING_FINAL_RESPONSE>
${LAST_ASSISTANT_MESSAGE}
</JOJO_PENDING_FINAL_RESPONSE>
处理可可靠归因且已获授权的阻断项后，必须继续完成原用户请求并重新交付上述答案；守护说明只能作为附注，不得只回复守护修复结果。"
    fi
fi
if ! printf '%s' "$CONTEXT" \
    | JOJO_HOOK_EVENT="$HOOK_EVENT" JOJO_HOOK_BLOCKED="$BLOCKED" PYTHONIOENCODING=utf-8 \
        "${PYTHON[@]}" -c '
import json
import os
import sys

event = os.environ["JOJO_HOOK_EVENT"]
blocked = os.environ.get("JOJO_HOOK_BLOCKED") == "true"
context = sys.stdin.read()
if event == "Stop":
    payload = {
        "continue": True,
        "decision": "block",
        "reason": context
        + "\n请先区分本轮修改与会话前已有内容；仅处理能可靠归因且已获授权的阻断项，重新检查后再结束本回合。",
    }
else:
    payload = {
        "continue": True,
        "hookSpecificOutput": {
            "hookEventName": "PostToolUse",
            "additionalContext": context,
        },
    }
    if blocked:
        payload["decision"] = "block"
        payload["reason"] = (
            "工作区检查发现阻断项。请先区分本轮修改与会话前已有内容；"
            "不得自动恢复、覆盖或删除来源不明的内容。"
        )
print(json.dumps(payload, ensure_ascii=False))
'; then
    echo "jojo-code-guard: failed to build structured ${HOOK_EVENT} output." >&2
    exit 2
fi
# 已完成的写入不会被伪装成未执行；阻断反馈会让 AI 根据诊断继续修复。
exit 0
