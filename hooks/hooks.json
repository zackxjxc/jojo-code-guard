{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash --norc --noprofile \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}/hooks/session-start\"",
            "commandWindows": "call \"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" session-start",
            "timeout": 10,
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash --norc --noprofile \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}/hooks/post-write-check\"",
            "commandWindows": "call \"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" post-write-check",
            "timeout": 60,
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash --norc --noprofile \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}/hooks/post-write-check\"",
            "commandWindows": "call \"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" post-write-check",
            "timeout": 60,
            "async": false
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash --norc --noprofile \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}/hooks/post-write-check\"",
            "commandWindows": "call \"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" post-write-check",
            "timeout": 60,
            "async": false
          }
        ]
      }
    ]
  }
}
